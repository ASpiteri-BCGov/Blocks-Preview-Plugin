{
	"name": "blocks-preview-plugin",
	"version": "0.1.0",
	"private": true,
	"description": "Preview WordPress block editor components as blocks.",
	"license": "Apache-2.0",
	"engines": {
		"npm": ">= 10.9.2",
		"node": ">=22.16.0"
	},
	"scripts": {
		"build": "wp-scripts build --blocks-manifest",
		"start": "wp-scripts start --blocks-manifest",
		"format": "wp-scripts format",
		"lint": "npm run lint:js && npm run lint:css",
		"lint:css": "wp-scripts lint-style 'src/**/*.{css,scss}' --allow-empty-input",
		"lint:js": "wp-scripts lint-js 'src/**/*.{js,jsx,ts,tsx}'",
		"fix:css": "wp-scripts lint-style 'src/**/*.{css,scss}' --fix --allow-empty-input",
		"fix:js": "wp-scripts lint-js 'src/**/*.{js,jsx,ts,tsx}' --fix"
	},
	"devDependencies": {
		"@bcgov/wordpress-eslint": "git+https://github.com/bcgov/wordpress-eslint.git#semver:1.x",
		"@wordpress/block-editor": "^15.20.0",
		"@wordpress/blocks": "^15.20.0",
		"@wordpress/components": "^34.0.0",
		"@wordpress/element": "^7.0.0",
		"@wordpress/icons": "^13.2.0",
		"@wordpress/i18n": "^6.20.0",
		"@wordpress/primitives": "^4.20.0",
		"@wordpress/rich-text": "^7.47.0",
		"@wordpress/scripts": "^32.3.0",
		"ajv": "^8.17.1"
	}
}
