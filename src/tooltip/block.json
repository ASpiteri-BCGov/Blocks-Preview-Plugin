{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "blocks-preview/tooltip",
	"version": "0.1.0",
	"title": "Tooltip",
	"category": "blocks-preview",
	"icon": "info",
	"example": {},
	"attributes": {
		"text": {
			"type": "string",
			"default": "Helpful tooltip text."
		},
		"triggerText": {
			"type": "string",
			"default": "Hover me"
		}
	},
	"supports": {
		"html": false
	},
	"textdomain": "blocks-preview",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css"
}
