{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "blocks-preview-bcds/tooltip",
	"version": "0.1.0",
	"title": "BCDS Tooltip",
	"category": "blocks-preview-bcds",
	"icon": "info",
	"example": {},
	"attributes": {
		"tooltipText": {
			"type": "string",
			"default": "Tooltip text"
