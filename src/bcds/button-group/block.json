{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "blocks-preview-bcds/button-group",
	"version": "0.1.0",
	"title": "BCDS Button Group",
	"category": "blocks-preview-bcds",
	"icon": "button",
	"example": {},
	"attributes": {
		"orientation": {
			"type": "string",
			"default": "horizontal"
		},
		"firstLabel": {
			"type": "string",
			"default": "First"
		},
		"secondLabel": {
			"type": "string",
			"default": "Second"
		}
	},
	"supports": {
		"html": false
	},
	"textdomain": "blocks-preview",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css"
}
