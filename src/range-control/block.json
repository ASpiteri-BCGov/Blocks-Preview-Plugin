{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "blocks-preview/range-control",
	"version": "0.1.0",
	"title": "Range Control",
	"category": "blocks-preview",
	"icon": "leftright",
	"example": {},
	"attributes": {
		"label": {
			"type": "string",
			"default": "Opacity"
		},
		"value": {
			"type": "number",
			"default": 50
		},
		"min": {
			"type": "number",
			"default": 0
		},
		"max": {
			"type": "number",
			"default": 100
		}
	},
	"supports": {
		"html": false
	},
	"textdomain": "blocks-preview",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css"
}
