{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "blocks-preview-guten/color-picker",
	"version": "0.1.0",
	"title": "Guten Color Picker",
	"category": "blocks-preview-guten",
	"icon": "art",
	"example": {},
	"attributes": {
		"color": {
			"type": "string",
			"default": "#72aee6"
		},
		"enableAlpha": {
			"type": "boolean",
			"default": true
		}
	},
	"supports": {
		"html": false
	},
	"textdomain": "blocks-preview",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css"
}
