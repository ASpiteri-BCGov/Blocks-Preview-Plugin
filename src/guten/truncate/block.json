{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "blocks-preview-guten/truncate",
	"version": "0.1.0",
	"title": "Guten Truncate",
	"category": "blocks-preview-guten",
	"icon": "editor-textcolor",
	"example": {},
	"attributes": {
		"content": {
			"type": "string",
			"default": "This is a very long line of text that should be truncated when space is limited."
		},
		"limit": {
			"type": "number",
			"default": 1
		}
	},
	"supports": {
		"html": false
	},
	"textdomain": "blocks-preview",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css"
}
