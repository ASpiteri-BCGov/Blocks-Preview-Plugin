{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "blocks-preview-guten/menu-items-choice",
	"version": "0.1.0",
	"title": "Guten Menu Items Choice",
	"category": "blocks-preview-guten",
	"icon": "yes",
	"example": {},
	"attributes": {
		"selected": {
			"type": "string",
			"default": "small"
		},
		"choices": {
			"type": "array",
			"default": [
				{
					"value": "small",
					"label": "Small"
				},
				{
					"value": "medium",
					"label": "Medium"
				},
				{
					"value": "large",
					"label": "Large"
				}
			]
		}
	},
	"supports": {
		"html": false
	},
	"textdomain": "blocks-preview",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css"
}
