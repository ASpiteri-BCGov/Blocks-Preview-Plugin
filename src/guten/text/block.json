{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "blocks-preview-guten/text",
	"version": "0.1.0",
	"title": "Guten Text",
	"category": "blocks-preview-guten",
	"icon": "editor-textcolor",
	"example": {},
	"attributes": {
		"content": {
			"type": "string",
			"default": "Sample text"
		},
		"size": {
			"type": "string",
			"default": "medium"
		}
	},
	"supports": {
		"html": false
	},
	"textdomain": "blocks-preview",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css"
}
