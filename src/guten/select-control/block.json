{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "blocks-preview-guten/select-control",
	"version": "0.1.0",
	"title": "Guten Select Control",
	"category": "blocks-preview-guten",
	"icon": "editor-ul",
	"example": {},
	"attributes": {
		"label": {
			"type": "string",
			"default": "Visibility"
		},
		"value": {
			"type": "string",
			"default": "public"
		},
		"options": {
			"type": "array",
			"default": [
				{
					"label": "Public",
					"value": "public"
				},
				{
					"label": "Private",
					"value": "private"
				}
			]
		}
	},
	"supports": {
		"html": false
	},
	"textdomain": "blocks-preview",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css"
}
