{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "blocks-preview-guten/button",
	"version": "0.1.0",
	"title": "Guten Button",
	"category": "blocks-preview-guten",
	"icon": "button",
	"example": {},
	"attributes": {
		"text": {
			"type": "string",
			"default": "Click here"
		},
		"variant": {
			"type": "string",
			"default": "primary"
		},
		"disabled": {
			"type": "boolean",
			"default": false
		},
		"isDestructive": {
			"type": "boolean",
			"default": false
		},
		"isPressed": {
			"type": "boolean",
			"default": false
		}
	},
	"supports": {
		"html": false
	},
	"textdomain": "blocks-preview",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css"
}
