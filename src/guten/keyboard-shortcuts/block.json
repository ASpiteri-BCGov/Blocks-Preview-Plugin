{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "blocks-preview-guten/keyboard-shortcuts",
	"version": "0.1.0",
	"title": "Guten Keyboard Shortcuts",
	"category": "blocks-preview-guten",
	"icon": "keyboard",
	"example": {},
	"attributes": {
		"shortcutName": {
			"type": "string",
			"default": "mod+k"
		},
		"shortcutLabel": {
			"type": "string",
			"default": "Open command palette"
		}
	},
	"supports": {
		"html": false
	},
	"textdomain": "blocks-preview",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css"
}
