{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "blocks-preview-guten/notice",
	"version": "0.1.0",
	"title": "Guten Notice",
	"category": "blocks-preview-guten",
	"icon": "info",
	"example": {},
	"attributes": {
		"status": {
			"type": "string",
			"default": "info"
		},
		"content": {
			"type": "string",
			"default": "This is an informational notice."
		},
		"isDismissible": {
			"type": "boolean",
			"default": true
		}
	},
	"supports": {
		"html": false
	},
	"textdomain": "blocks-preview",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css"
}
