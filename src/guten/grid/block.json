{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "blocks-preview-guten/grid",
	"version": "0.1.0",
	"title": "Guten Grid",
	"category": "blocks-preview-guten",
	"icon": "grid-view",
	"example": {},
	"attributes": {
		"columns": {
			"type": "number",
			"default": 2
		},
		"item1": {
			"type": "string",
			"default": "Cell one"
		},
		"item2": {
			"type": "string",
			"default": "Cell two"
		}
	},
	"supports": {
		"html": false
	},
	"textdomain": "blocks-preview",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css"
}
