{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "blocks-preview/search-control",
	"version": "0.1.0",
	"title": "Search Control",
	"category": "blocks-preview",
	"icon": "search",
	"example": {},
	"attributes": {
		"label": {
			"type": "string",
			"default": "Search"
		},
		"value": {
			"type": "string",
