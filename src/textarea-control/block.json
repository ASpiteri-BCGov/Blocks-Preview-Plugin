{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "blocks-preview/textarea-control",
	"version": "0.1.0",
	"title": "Textarea Control",
	"category": "blocks-preview",
	"icon": "editor-paragraph",
	"example": {},
	"attributes": {
		"label": {
			"type": "string",
			"default": "Description"
		},
		"value": {
			"type": "string",
			"default": "Sample description text."
		},
		"rows": {
			"type": "number",
			"default": 4
		}
	},
	"supports": {
		"html": false
	},
	"textdomain": "blocks-preview",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css"
}
