{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "blocks-preview/flex",
	"version": "0.1.0",
	"title": "Flex",
	"category": "blocks-preview",
	"icon": "columns",
	"example": {},
	"attributes": {
		"direction": {
			"type": "string",
			"default": "row"
		},
		"justify": {
			"type": "string",
			"default": "flex-start"
		},
		"align": {
			"type": "string",
			"default": "stretch"
		}
	},
	"supports": {
		"html": false
	},
	"textdomain": "blocks-preview",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css"
}
