{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "blocks-preview/font-size-picker",
	"version": "0.1.0",
	"title": "Font Size Picker",
	"category": "blocks-preview",
	"icon": "editor-textcolor",
	"example": {},
	"attributes": {
		"fontSize": {
			"type": "string",
			"default": "16px"
		},
		"fontSizes": {
			"type": "array",
			"default": [
				{
					"name": "Small",
					"slug": "small",
					"size": "13px"
				},
				{
					"name": "Medium",
					"slug": "medium",
					"size": "16px"
				},
				{
					"name": "Large",
					"slug": "large",
					"size": "24px"
				}
			]
		}
	},
	"supports": {
		"html": false
	},
	"textdomain": "blocks-preview",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css"
}
